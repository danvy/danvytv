---
import BaseLayout from "../layouts/BaseLayout.astro";
import SocialIcons from "../components/SocialIcons.astro";
import { HOME_INFO } from "../consts";
---

<BaseLayout>
  <section class="profile">
    <img
      src="/logo.svg"
      alt="Logo"
      width="120"
      height="120"
      class="profile-logo"
    />
    <h1>{HOME_INFO.title}</h1>
    <p class="profile-subtitle">{HOME_INFO.content}</p>
    <SocialIcons />
  </section>
</BaseLayout>
